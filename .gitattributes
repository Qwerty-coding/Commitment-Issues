# Normalize all text files to LF on check-in so Windows checkouts do not
# produce CRLF/gofmt churn.
* text=auto eol=lf

# Explicit source/text types (kept LF for tooling stability).
*.go text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets are never line-converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
